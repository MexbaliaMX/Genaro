{
  "name": "genaro-dft-api",
  "version": "2.0.0",
  "description": "Genaro DFT 2.0 API Server implementing OpenAPI and AsyncAPI contracts",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/server.js",
    "dev": "node server.js",
    "lint": "eslint ./**/*.js",
    "test": "npm run accessibility-test && npm run test:api",
    "accessibility-test": "node ../../../accessibility-check.js",
    "test:api": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "genaro",
    "dft",
    "api",
    "openapi",
    "asyncapi",
    "node",
    "express"
  ],
  "author": "MexbaliaMX",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "axe-core": "^4.9.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "pa11y": "^8.0.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
